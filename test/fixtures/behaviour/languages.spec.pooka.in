//// Two small languages, lexed by lexers lexie generated from the
//// specifications in test/fixtures/specifications. Poke checks the output
//// in the generated consumer project as well as in Lexie itself.

// SPDX-License-Identifier: Apache-2.0

module languages_test

import poke/should

import calc/highlighter.{Category, Highlight}
import calc/lexer as calc_lexer
import calc/token as calc
import lisp/lexer as lisp_lexer
import lisp/token as lisp
import pooka/list

test "a calculator: numbers with separators, floats with exponents" {
  let tokens = list.map(
    calc_lexer.lex("answer = (1_000 + 2.5e3) * 3 == 10500"),
    fn(l: calc.Lexeme) { l.token }
  )
  should.equal(tokens, [
    calc.Ident("answer"),
    calc.Equal(),
    calc.LeftParen(),
    calc.IntLiteral("1_000"),
    calc.Plus(),
    calc.FloatLiteral("2.5e3"),
    calc.RightParen(),
    calc.Star(),
    calc.IntLiteral("3"),
    calc.EqualEqual(),
    calc.IntLiteral("10500"),
    calc.End()
  ])
}

test "a calculator's highlighter names each piece" {
  let pieces = list.map(highlighter.highlight("1 + x"), fn(h: Highlight) {
    #(h.category, h.text)
  })
  should.equal(pieces, [
    #(Category.Number, "1"),
    #(Category.Operator, "+"),
    #(Category.Identifier, "x")
  ])
}

test "Lisp: symbols full of punctuation, and comments left out" {
  let tokens = list.map(
    lisp_lexer.lex("; squares\n(set-car! pair 'nil?)"),
    fn(l: lisp.Lexeme) { l.token }
  )
  should.equal(tokens, [
    lisp.LeftParen(),
    lisp.Symbol("set-car!"),
    lisp.Symbol("pair"),
    lisp.Quote(),
    lisp.Symbol("nil?"),
    lisp.RightParen(),
    lisp.End()
  ])
}
