//// Teach a computer to read your language, one word at a time.
////
//// Lexie turns a token specification, written in TOML, into plain Pooka
//// modules: a `Token` family, a lexer, source positions and, if you ask, a
//// syntax highlighter. The generated code needs nothing but the standard
//// library, so lexie is only ever a development dependency.
////
//// Most of the time you will not call this module yourself. Add lexie to a
//// project and run it with `pooka run -m lexie`; the guide shows how. The
//// functions here are for tools that want the files without the disk:
//// `generate` checks a specification and returns the files to write, or
//// every problem at once.
////
//// ```pooka
//// import lexie
//// import lexie/config
//// import pooka/list
////
//// let assert Ok(files) = lexie.generate(config.default_config())
//// assert list.map(files, fn(f: lexie.GeneratedFile) { f.path }) == [
////   "src/location.pooka",
////   "src/token.pooka",
////   "src/lexer.pooka"
//// ]
//// ```

// SPDX-License-Identifier: Apache-2.0

module lexie

import lexie/check
import lexie/config.{Config, ConfigError}
import lexie/emit
import lexie/generate_highlighter
import lexie/generate_lexer
import lexie/generate_location
import lexie/generate_token
import pooka/list
import pooka/string
import tome

/// A file to write: where it goes, relative to the project, and what it says.
class GeneratedFile(path: String, content: String)

/// Check a specification and generate its files: `location.pooka`,
/// `token.pooka` and `lexer.pooka`, plus `highlighter.pooka` when the
/// highlighter is enabled. Nothing is written; that is up to the caller.
///
/// A specification with problems produces no files at all, and every
/// problem comes back at once, so they can be fixed in one sitting.
///
/// ```pooka
/// import lexie
/// import lexie/config
///
/// let result = lexie.generate(config.default_config())
/// // Ok(files), ready to write; no files have been touched yet.
/// ```
generate(c: Config) -> Result(List(GeneratedFile), List(ConfigError)) {
  match check.validate(c) {
    [_, ..] -> Error(check.validate(c))
    [] -> {
      let files = [
        GeneratedFile(
          emit.file_path(c, "location.pooka"),
          generate_location.source()
        ),
        GeneratedFile(
          emit.file_path(c, "token.pooka"),
          generate_token.source(c)
        ),
        GeneratedFile(
          emit.file_path(c, "lexer.pooka"),
          generate_lexer.source(c)
        )
      ]
      match c.highlighter {
        True -> Ok(
          list.append(
            files,
            GeneratedFile(
              emit.file_path(c, "highlighter.pooka"),
              generate_highlighter.source(c)
            )
          )
        )
        False -> Ok(files)
      }
    }
  }
}

/// Read standalone TOML text, retaining every configuration problem.
///
/// ```pooka
/// import lexie
///
/// let text = "[keywords]\nitems = [\"let\"]\n"
/// let result = lexie.read(text)
/// // Ok(#(specification, problems)); generate validates before emitting code.
/// ```
read(text: String) -> Result(#(Config, List(ConfigError)), String) {
  match tome.parse(text) {
    Error(problem) -> Error("invalid TOML, " + tome.describe(problem))
    Ok(document) -> Ok(config.parse(document))
  }
}

/// Is this file one lexie generated? Only those are ever overwritten or
/// removed: lexie looks for its marker on the very first line.
///
/// ```pooka
/// import lexie
///
/// assert lexie.is_generated("//// Code generated by lexie. DO NOT EDIT.\n")
/// assert !lexie.is_generated("module lexer\n")
/// ```
is_generated(content: String) -> Bool {
  string.starts_with(content, emit.marker() + "\n")
}
