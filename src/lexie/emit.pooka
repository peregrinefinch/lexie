//// The pen and ink the generators share.
////
//// Small helpers for writing Pooka source: string literals, bit-array
//// patterns, paths, indentation, and the order fixed tokens are tried in.

// SPDX-License-Identifier: Apache-2.0

module emit

import lexie/config.{Config}
import pooka/bit_array
import pooka/int
import pooka/list
import pooka/order.{Order}
import pooka/string

/// The first line of every generated file. `clean` and `generate` only ever
/// touch files that start with it.
marker() -> String {
  "//// Code generated by lexie. DO NOT EDIT."
}

/// A generated module's opening comment.
header(what: String) -> String {
  marker() + "\n////\n//// " + what + "\n//// Regenerate with `pooka run -m lexie` after changing the specification.\n"
}

/// The import path of a generated module, such as `syntax/lexer`.
module_path(c: Config, leaf: String) -> String {
  let directory = list.filter(string.split(c.output_dir, "/"), fn(part) {
    part != "" && part != "."
  })
  let output_prefix = match directory {
    ["src", ..parts] -> parts
    _ -> []
  }
  let prefix = string.join(
    list.concat(output_prefix, match c.module_name {
      "" -> []
      name -> [name]
    }),
    "/"
  )
  match prefix {
    "" -> leaf
    _ -> prefix + "/" + leaf
  }
}

/// Lines of generated code, joined.
lines(all: List(String)) -> String {
  string.join(all, "\n")
}

/// Where a generated file goes, such as `src/syntax/lexer.pooka`.
file_path(c: Config, file: String) -> String {
  match c.module_name {
    "" -> c.output_dir + "/" + file
    prefix -> c.output_dir + "/" + prefix + "/" + file
  }
}

/// Text as a Pooka string literal.
literal(text: String) -> String {
  "\"" + string.join(list.map(string.to_list(text), _escape_code), "") + "\""
}

_escape_code(c: Int) -> String {
  match c {
    92 -> "\\\\"
    34 -> "\\\""
    10 -> "\\n"
    13 -> "\\r"
    9 -> "\\t"
    _ if c < 32 || c == 127 -> "\\u{" + _hex(c) + "}"
    _ -> _character(c)
  }
}

_hex(c: Int) -> String {
  match int.to_base(c, 16) {
    Ok(digits) -> string.lowercase(digits)
    Error(_) -> "0"
  }
}

_character(c: Int) -> String {
  match bit_array.to_string(_utf8(c)) {
    Ok(text) -> text
    Error(_) -> ""
  }
}

/// A code point as UTF-8.
_utf8(c: Int) -> BitArray {
  match c {
    _ if c < 128 -> <<c:size(8)>>
    _ if c < 2048 -> {
      let assert <<a:size(5), b:size(6)>> = <<c:size(11)>>
      <<6:size(3), a:size(5), 2:size(2), b:size(6)>>
    }
    _ if c < 65536 -> {
      let assert <<a:size(4), b:size(6), d:size(6)>> = <<c:size(16)>>
      <<14:size(4), a:size(4), 2:size(2), b:size(6), 2:size(2), d:size(6)>>
    }
    _ -> {
      let assert <<a:size(3), b:size(6), d:size(6), e:size(6)>> = <<c:size(21)>>
      <<30:size(5), a:size(3), 2:size(2), b:size(6), 2:size(2), d:size(6), 2:size(
        2
        ), e: size(6)>>
    }
  }
}

/// The number of UTF-8 bytes in the text.
bytes(text: String) -> Int {
  string.byte_size(text)
}

/// The number of characters in the text, as the generated code counts
/// columns.
columns(text: String) -> Int {
  string.length(text)
}

/// A bit-array pattern for text at the start, binding what follows:
/// `<<"==":utf8, after:bits>>`.
starts_with(text: String, binding: String) -> String {
  "<<" + literal(text) + ":utf8, " + binding + ":bits>>"
}

/// Indent every non-empty line.
indent(text: String, spaces: Int) -> String {
  let pad = string.repeat(" ", spaces)
  string.join(
    list.map(string.split(text, "\n"), fn(line: String) {
      match line {
        "" -> ""
        _ -> pad + line
      }
    }),
    "\n"
  )
}

/// Longest text first, then alphabetical: the order in which fixed tokens
/// must be tried.
longest_first(items: List(#(String, a))) -> List(#(String, a)) {
  list.sort_by(items, fn(x: #(String, a), y: #(String, a)) {
    match int.compare(bytes(y.0), bytes(x.0)) {
      Order.Equal -> string.compare(x.0, y.0)
      other -> other
    }
  })
}
